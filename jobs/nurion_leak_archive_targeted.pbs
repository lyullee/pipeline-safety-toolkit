#!/bin/bash
#PBS -N pipe-leak-archive
#PBS -j oe
#PBS -l walltime=00:30:00

set -euo pipefail
: "${PBS_O_WORKDIR:?Submit from the staged source checkout}"
: "${PBS_NODEFILE:?PBS compute-node allocation is required}"
: "${PIPELINE_HPC_PYTHON:?Set a compute-node-compatible Linux Python 3.12+ interpreter}"
: "${PIPELINE_HPC_DATA_MAP:?Set the private shared-read-only data map}"
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export PYTHONHASHSEED=0
export PYTHONIOENCODING=utf-8
RUN_ROOT="${PIPELINE_HPC_RESULTS:-$PBS_O_WORKDIR/artifacts/hpc/${PBS_JOBID}}"
mkdir -p "$(dirname "$RUN_ROOT")"
mkdir "$RUN_ROOT"
PLAN="$RUN_ROOT/manifest.json"
"$PIPELINE_HPC_PYTHON" scripts/hpc_tests.py prepare \
  --shards 1 \
  --only-tests tests/test_leak_multisensor_archive_hpc.py \
  --data-map "$PIPELINE_HPC_DATA_MAP" \
  --manifest "$PLAN"
launch_status=0
mpirun -np 1 "$PIPELINE_HPC_PYTHON" scripts/hpc_tests.py run \
  --manifest "$PLAN" --results "$RUN_ROOT" --data-map "$PIPELINE_HPC_DATA_MAP" || launch_status=$?
aggregate_status=0
"$PIPELINE_HPC_PYTHON" scripts/hpc_tests.py aggregate \
  --manifest "$PLAN" --results "$RUN_ROOT" || aggregate_status=$?
if [ "$launch_status" -ne 0 ] || [ "$aggregate_status" -ne 0 ]; then
  exit 1
fi
